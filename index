  $('#chatmsg').textContent='checking...';
  try{
    const r=await fetch('https://api.telegram.org/bot'+t+'/getUpdates');
    const j=await r.json();
    if(!j.ok){$('#chatmsg').textContent='bad token: '+j.description;return}
    let id=null;
    for(const u of j.result||[]) if(u.message&&u.message.chat) id=u.message.chat.id;
