}

function esc(s){return (s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}

async function pull(){
  const c=load();if(!c.token){$('#status').textContent='no token saved - build first';return}
  $('#status').textContent='pulling...';
  try{
    const r=await fetch('https://api.telegram.org/bot'+c.token+'/getUpdates?offset='+off+'&limit=100');
    const j=await r.json();
    if(!j.ok){$('#status').textContent='error: '+j.description;return}
    const h=hist();
    for(const u of j.result||[]){
      off=u.update_id+1;
      const m=u.message||u.channel_post;
      if(!m||!m.document)continue;
      h.unshift({id:m.document.file_id,name:m.document.file_name,size:m.document.file_size,
                 cap:m.caption||'',date:m.date});
    }
    localStorage.setItem('mm.off',off);
    localStorage.setItem('mm.hist',JSON.stringify(h.slice(0,200)));
    render();
    $('#status').innerHTML='<span class="ok">'+h.length+' packages held locally</span>';
  }catch(e){$('#status').textContent='network error'}
}

function render(){
  const h=hist();
  $('#feed').innerHTML=h.length?h.map(x=>{
    const t=(x.cap.match(/\[([A-F0-9]{8})\]/)||[])[1]||'----';
    return '<div class="item"><div class="meta"><span class="tag live">'+t+'</span>'+
      '<span>'+(x.size/1048576).toFixed(2)+' MB</span></div>'+
      '<div class="cap">'+esc(x.cap)+'</div>'+
      '<button onclick="get(\''+x.id+'\',\''+esc(x.name)+'\')">DOWNLOAD</button></div>';
  }).join(''):'<p class="hint">nothing yet</p>';
}

