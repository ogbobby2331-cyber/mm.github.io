<script type="text/plain" id="wtpl">
export default {
  async fetch(req, env) {
    const u = new URL(req.url);
    if (u.pathname !== "/up") return new Response("ok");
    if (req.method !== "POST") return new Response("method", { status: 405 });
    const body = await req.arrayBuffer();
    const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(env.SECRET),
      { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
    const mac = await crypto.subtle.sign("HMAC", key, body);
    const hex = [...new Uint8Array(mac)].map(b => b.toString(16).padStart(2, "0")).join("");
    if (hex !== (req.headers.get("X-Sig") || "")) return new Response("sig", { status: 401 });
    const r = await fetch(`https://api.telegram.org/bot${env.TOKEN}/sendDocument`, {
      method: "POST", headers: { "content-type": req.headers.get("content-type") }, body
    });
    return new Response(await r.text(), { status: r.status });
  }
}
</script>
